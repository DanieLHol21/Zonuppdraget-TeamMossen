#!/usr/sbin/nft -f
flush ruleset

table inet zon {
    chain in {
        type filter hook input priority 0; policy drop;
        ct state established,related accept
        ct state invalid drop
        iif "lo" accept
        ip saddr 172.20.1.2 tcp dport 22 accept comment "F3 SSH från jump (D1)"
        ip saddr 172.20.1.10 tcp dport 22 accept comment "F13a kontroll från ctf (D2)"
        iif "eth0" tcp dport 80 accept comment "F1 webb från internet"
        ip saddr 172.20.1.10 tcp dport 80 accept comment "F13b webbkontroll från ctf"
        ip saddr 172.20.1.2 icmp type echo-request accept comment "F14 ping från jump"
        limit rate 10/minute log prefix "ZON-IN-DROP " level info
    }
    chain ut {
        type filter hook output priority 0; policy drop;
        ct state established,related accept
        oif "lo" accept
        ip daddr { 185.12.64.1, 185.12.64.2 } meta l4proto { tcp, udp } th dport 53 accept comment "F11a-b DNS (D3)"
        oif "eth0" udp dport 123 accept comment "F11c NTP (D4)"
        oif "eth0" tcp dport 443 accept comment "F11d uppdateringar (D7)"
        ip daddr 172.20.1.58 tcp dport 514 accept comment "D5 brandväggslogg till log"
        ip daddr 172.20.1.58 tcp dport 6514 accept comment "F7a loggar till log TLS"
        udp sport 68 udp dport 67 accept comment "D6 DHCP"
        limit rate 10/minute log prefix "ZON-UT-DROP " level info
    }
}
